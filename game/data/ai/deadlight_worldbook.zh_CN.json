      "keywords": ["逃出", "栅栏", "划破", "记忆"],
      "text_key": "worldbook.emilia.memory.backyard",
      "text": "走到屋外她会想起：“那天晚上，我从这里跑出去的。”“我翻过栅栏。我的手被划破了。”",
      "speakers": ["emilia"], "public_scene": [], "scenes": [], "topics": ["manor.room.outside"], "conditions": []
    },
    {
