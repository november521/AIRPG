{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "locale", "content_path", "debug_panel", "input_bindings"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "locale": {"type": "string", "enum": ["zh_CN"]},
    "content_path": {"type": "string", "pattern": "^res://data/packs/[a-z0-9_]+\\.json$"},
    "debug_panel": {"type": "boolean"},
    "input_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["move_left", "move_right", "move_up", "move_down", "interact", "investigate", "debug_toggle"],
      "properties": {
        "move_left": {"type": "string", "minLength": 1},
        "move_right": {"type": "string", "minLength": 1},
        "move_up": {"type": "string", "minLength": 1},
        "move_down": {"type": "string", "minLength": 1},
        "interact": {"type": "string", "minLength": 1},
        "investigate": {"type": "string", "minLength": 1},
        "debug_toggle": {"type": "string", "minLength": 1}
      }
    }
  }
}
