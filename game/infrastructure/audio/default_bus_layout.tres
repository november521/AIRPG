[gd_resource type="AudioBusLayout" format=3]

; The manor's audio routing contract. Master is the implicit bus 0 and carries no send of its own.
; Every other bus sends to Master, which is the player-facing master volume.
; Levels are the mixer's starting point, not a mastering decision: music and ambience beds are
; loudness-normalised (I = -18 / -24 LUFS) while one-shots are peak-normalised to -3 dBFS, so the
; beds are trimmed here and the transients keep their headroom.
[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -6.0
bus/1/send = &"Master"
bus/2/name = &"Ambience"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = -9.0
bus/2/send = &"Master"
bus/3/name = &"SFX"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = -2.0
bus/3/send = &"Master"
bus/4/name = &"UI"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = -4.0
bus/4/send = &"Master"
bus/5/name = &"Voice"
bus/5/solo = false
bus/5/mute = false
bus/5/bypass_fx = false
bus/5/volume_db = 0.0
bus/5/send = &"Master"
